{
  "io_objects": [
    {
      "ob_id": 0,
      "ob_type": "variable",
      "ob_content": "#801",
      "ob_name": "API ROSA của kho",
      "ob_value": "rosa.technology/api/<<sessionid>>/<<syncid>>",
      "ob_desc": "Tự điền theo thiết bị và tài khoản khi nạp trang mẫu.",
      "ob_state": 1
    },
    {
      "ob_id": 1,
      "ob_type": "variable",
      "ob_content": "#1001",
      "ob_name": "API key camera Vision",
      "ob_value": "",
      "ob_desc": "Nhập cùng camera key đã khai báo trong cài đặt kho; mẫu một camera dùng N20.",
      "ob_state": 1
    },
    {
      "ob_id": 2,
      "ob_type": "variable",
      "ob_content": "#1002",
      "ob_name": "Chu kỳ đọc kết quả AI (giây)",
      "ob_value": "5",
      "ob_desc": "Chỉ đọc khi đang có yêu cầu đếm.",
      "ob_state": 1
    },
    {
      "ob_id": 3,
      "ob_type": "variable",
      "ob_content": "#1003",
      "ob_name": "Chu kỳ thử lại báo kho (giây)",
      "ob_value": "10",
      "ob_desc": "Giữ nguyên request_id khi thử lại.",
      "ob_state": 1
    },
    {
      "ob_id": 4,
      "ob_type": "variable",
      "ob_content": "#101",
      "ob_name": "Đang thực hiện kiểm kê",
      "ob_value": "0",
      "ob_desc": "0: rảnh; 1: đang đếm hoặc gửi báo cáo.",
      "ob_state": 1
    },
    {
      "ob_id": 5,
      "ob_type": "variable",
      "ob_content": "#102",
      "ob_name": "SĐT người yêu cầu",
      "ob_value": "",
      "ob_desc": "Nhận từ N20; để trống khi cảm biến kích hoạt.",
      "ob_state": 1
    },
    {
      "ob_id": 6,
      "ob_type": "variable",
      "ob_content": "#103",
      "ob_name": "Mã yêu cầu đếm AI",
      "ob_value": "",
      "ob_desc": "UUID do ROSA trả về ở c3.",
      "ob_state": 1
    },
    {
      "ob_id": 7,
      "ob_type": "variable",
      "ob_content": "#104",
      "ob_name": "Trạng thái kiểm kê",
      "ob_value": "idle",
      "ob_desc": "accepted/running/checking hoặc trạng thái cuối/lỗi giao tiếp.",
      "ob_state": 1
    }
  ],
  "io_actions": [],
  "io_events": [],
  "io_programs": [
    {
      "io_group_id": 0,
      "io_group": "Kích hoạt kiểm kê",
      "io_group_desc": "Nhận lệnh từ trang nhân viên hoặc cảm biến; mẫu một camera.",
      "io_n_list": [
        {
          "n_id": "20",
          "n_mode": "1",
          "n_name": "Yêu cầu kiểm kê từ nhân viên",
          "n_desc": "Điểm vào của nút Cập nhật trên trang nhân viên. Mẫu một camera; SĐT được giữ để ghi lịch sử.",
          "n_natural": "",
          "n_content": "// N20,\"số điện thoại\"; không khởi tạo job khác khi đang bận\n[#101=1](D8)\n[#1001=\"\"](D4#104,\"missing_camera_key\"D8)\nD4#101,1\nD4#102,#1\nD4#103,\"\"\nD4#104,\"submitting\"\nD6N21\n",
          "n_local_def": [
            {
              "l_id": 2001,
              "l_type": "variable",
              "l_cm": "#1",
              "l_natural": "SĐT nhân viên đã xác minh"
            }
          ]
        },
        {
          "n_id": "23",
          "n_mode": "1",
          "n_name": "Yêu cầu kiểm kê từ cảm biến",
          "n_desc": "Gọi D5N23 trong sự kiện cảm biến phù hợp. Chưa gắn chân I hay điều kiện phần cứng.",
          "n_natural": "",
          "n_content": "D5N20,\"\"\n",
          "n_local_def": []
        }
      ]
    },
    {
      "io_group_id": 1,
      "io_group": "Đếm AI và báo cáo kho",
      "io_group_desc": "Gửi đếm, đọc kết quả và điểm nối ghi lịch sử. Mẫu chưa test, còn thiếu JSON đầy đủ từ API.",
      "io_n_list": [
        {
          "n_id": "21",
          "n_mode": "1",
          "n_name": "Gửi yêu cầu và đọc kết quả AI",
          "n_desc": "Chờ AI bằng chu kỳ #1002, không giới hạn 60 giây. Cần hoàn thiện metadata.phone và nhận toàn bộ JSON; xem ghi chú gói mẫu.",
          "n_natural": "",
          "n_content": "// Bản cơ bản: ROSA tạo UUID; không tự gửi lại ai-count khi mất ACK\nD4#1,\"\"\nD23,#801,#1,\"ai-count\",#1001\n[#1<>\"OK\"](D4#104,\"submit_error\"D4#101,0D8)\nD4#103,#3\nD4#104,#4\nL(\n W#1002\n D4#1,\"\"\n D4#6,\"\"\n D23,#801,#1,\"ai-count-result\",#103\n [#1=\"OK\"](\n  D4#104,#4\n  [#4=\"succeeded\"|#4=\"failed\"|#4=\"partial\"|#4=\"busy\"|#4=\"unknown\"](\n   // API hiện chỉ có c1..c5; c6 đầy đủ JSON chưa được cung cấp\n   D6N22,#6\n   D8\n  )\n )\n)\n",
          "n_local_def": [
            {
              "l_id": 2101,
              "l_type": "variable",
              "l_cm": "#1",
              "l_natural": "Mã phản hồi API — c1"
            },
            {
              "l_id": 2102,
              "l_type": "variable",
              "l_cm": "#2",
              "l_natural": "Cờ phản hồi API — c2"
            },
            {
              "l_id": 2103,
              "l_type": "variable",
              "l_cm": "#3",
              "l_natural": "UUID phản hồi — c3"
            },
            {
              "l_id": 2104,
              "l_type": "variable",
              "l_cm": "#4",
              "l_natural": "Trạng thái đếm — c4"
            },
            {
              "l_id": 2105,
              "l_type": "variable",
              "l_cm": "#5",
              "l_natural": "Danh sách sản phẩm JSON — c5"
            },
            {
              "l_id": 2106,
              "l_type": "variable",
              "l_cm": "#6",
              "l_natural": "JSON kết quả đầy đủ — chờ hợp đồng API"
            }
          ]
        },
        {
          "n_id": "22",
          "n_mode": "1",
          "n_name": "Ghi kết quả kiểm kê vào kho",
          "n_desc": "Điểm nối báo kho; chưa hoạt động trọn luồng vì API đếm chưa có c6 JSON đầy đủ. Dừng rõ lỗi missing_result_json thay vì ghi sai tồn.",
          "n_natural": "",
          "n_content": "// #1 phải chứa JSON đầy đủ, không phải chỉ danh sách sản phẩm c5\n[#1=\"\"](D4#104,\"missing_result_json\"D4#101,0D8)\nL(\n D4#2,\"\"\n D23,#801,#2,\"data\",\"warehouse-io-result\",#1,#102\n [#2=\"OK\"](D4#104,\"reported\"D4#101,0D8)\n W#1003\n)\n",
          "n_local_def": [
            {
              "l_id": 2201,
              "l_type": "variable",
              "l_cm": "#1",
              "l_natural": "JSON đầy đủ của lần đếm"
            },
            {
              "l_id": 2202,
              "l_type": "variable",
              "l_cm": "#2",
              "l_natural": "Mã xác nhận ghi kho — c1"
            },
            {
              "l_id": 2203,
              "l_type": "variable",
              "l_cm": "#3",
              "l_natural": "UUID đã ghi kho — c2"
            },
            {
              "l_id": 2204,
              "l_type": "variable",
              "l_cm": "#4",
              "l_natural": "Trạng thái bản ghi kho — c3"
            }
          ]
        }
      ]
    }
  ],
