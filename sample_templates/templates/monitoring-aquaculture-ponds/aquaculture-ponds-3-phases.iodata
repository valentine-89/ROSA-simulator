      "io_group": "Chương trình chính",
      "io_n_list": [
        {
          "n_id": "1",
          "n_name": "cập nhật chung",
          "n_content": "// N1: Vong cap nhat ao 1-2 va gui co cho phep cap nhat\n\tI99-1\n\tW5\n\tL(\n\t\tD4#103,#904-#3\n\t\tD4#3,#904\n\t\t[#1003.1=\"ON\"](\n\t\t\tD1O1'2'\n\t\t\tD6N41,#1\n\t\t\tD2O1\n\t\t\t[#891>0](\n\t\t\t\tW3\n\t\t\t)(\n\t\t\t\tW1\n\t\t\t)\n\t\t)\n\t\t[#1003.2=\"ON\"](\n\t\t\tD1O1'2'\n\t\t\tD6N42,#1\n\t\t\tD2O1\n\t\t\t[#891>0](\n\t\t\t\tW3\n\t\t\t)(\n\t\t\t\tW1\n\t\t\t)\n\t\t)\n\t\t[#891>10](\n\t\t\tW10\n\t\t)\n\t\t[#1003<>#2|#1%60=0](\n\t\t\tD4#2,#1003\n\t\t\tD23,#801,,\"telemetry\",\"#1003.1=\"#1003.1,\"#1003.2=\"#1003.2\n\t\t)\n\t\tD4#1,#1+1\n\t)\n",
          "n_mode": "1",
          "n_returncm": false,
          "n_disabledcm": false,
          "n_natural": "",
          "n_local_def": []
        },
        {
          "n_id": "2",
          "n_name": "gửi timeseries",
          "n_content": "// N2: Gui dien ap va dong dien ba pha theo du lieu hop le\n\t[(#2<>\"ERROR\"&#6<>\"ERROR\")](\n\t\tD23,#801,,\"timeseries\",\"Voltage\"#1.1\"_V=\"#2,\"Current\"#1.1\"_A1=\"#3,\"Current\"#1.1\"_A2=\"#4,\"Current\"#1.1\"_A3=\"#5,\"Voltage\"#1.2\"_V=\"#6,\"Current\"#1.2\"_A1=\"#7,\"Current\"#1.2\"_A2=\"#8,\"Current\"#1.2\"_A3=\"#9\n\t)(\n\t\t[#2<>\"ERROR\"](\n\t\t\tD23,#801,,\"timeseries\",\"Voltage\"#1.1\"_V=\"#2,\"Current\"#1.1\"_A1=\"#3,\"Current\"#1.1\"_A2=\"#4,\"Current\"#1.1\"_A3=\"#5\n\t\t)\n\t\t[#6<>\"ERROR\"](\n\t\t\tD23,#801,,\"timeseries\",\"Voltage\"#1.2\"_V=\"#6,\"Current\"#1.2\"_A1=\"#7,\"Current\"#1.2\"_A2=\"#8,\"Current\"#1.2\"_A3=\"#9\n\t\t)\n\t)\n",
          "n_mode": "1",
          "n_returncm": false,
          "n_disabledcm": false,
          "n_natural": "",
          "n_desc": "",
          "n_local_def": []
        },
        {
          "n_id": "41",
          "n_name": "cập nhật ao 1",
          "n_content": "// N41: Doc hai quat ao 1; cap nhat sau lich #1021-#1026\n\tD4#2,\n\tI101\n\tD4#3,\n\tI102\n\t[#1%3=0](\n\t\tD6N2,\"11,12\",#2.1,#2.8,#2.9,#2.10,#3.1,#3.8,#3.9,#3.10\n\t)\n\tD6,#4,N102,11,#2.8\",\"#2.9\",\"#2.10,#2.11\n\tD6,#5,N102,12,#3.8\",\"#3.9\",\"#3.10,#3.11\n\t[#5=\"null\"](\n\t\tD4#5,#4\n\t)\n\tD5N7,#2.11#3.11,#5.1,#5.2\"A \"#5.3\"A \"#5.4\"A\"\n\tD4#5,#2.11\",\"#3.11\",\"#1002\",\"#1003\",\"#1004\",\"#1005\",\"#1006\",\"#1010\",\"#1011\",\"#1021\",\"#1022\",\"#1023\",\"#1024\",\"#1025\",\"#1026\n\t[(#5<>#117|#1%60=0)](\n\t\tD4#117,#5\n\t\tD23,#801,,\"timeseries\",\"Temper11=\"#2.12,\"Temper12=\"#3.12\n\t\tD23,#801,,\"telemetry\",\"#1021=\"#1021,\"#1022=\"#1022,\"#1023=\"#1023,\"#1024=\"#1024,\"#1025=\"#1025,\"#1026=\"#1026,\"O101=\"#2.11,\"O102=\"#3.11,\"Energy11_Wh=\"#2.6,\"Energy12_Wh=\"#3.6\n\t\tD23,#801,,\"telemetry\",\"#1002=\"#1002,\"#1004=\"#1004,\"#1005=\"#1005,\"#1011=\"#1011\n\t)\n",
          "n_mode": "1",
          "n_returncm": false,
          "n_disabledcm": false,
          "n_natural": "",
          "n_desc": "",
          "n_local_def": [
            {
              "l_id": 70896,
