        {
          "n_id": "42",
          "n_name": "cập nhật ao 2",
          "n_content": "// N42: Doc hai quat ao 2; cap nhat sau lich #1027-#1032\n\tD4#2,\n\tI103\n\tD4#3,\n\tI104\n\t[#1%3=0](\n\t\tD6N2,\"21,22\",#2.1,#2.8,#2.9,#2.10,#3.1,#3.8,#3.9,#3.10\n\t)\n\tD6,#4,N102,21,#2.8\",\"#2.9\",\"#2.10,#2.11\n\tD6,#5,N102,22,#3.8\",\"#3.9\",\"#3.10,#3.11\n\t[#5=\"null\"](\n\t\tD4#5,#4\n\t)\n\tD5N8,#2.11#3.11,#5.1,#5.2\"A \"#5.3\"A \"#5.4\"A\"\n\tD4#5,#2.11\",\"#3.11\",\"#1002\",\"#1003\",\"#1004\",\"#1006\",\"#1010\",\"#1012\",\"#1027\",\"#1028\",\"#1029\",\"#1030\",\"#1031\",\"#1032\n\t[(#5<>#118|#1%60=0)](\n\t\tD4#118,#5\n\t\tD23,#801,,\"timeseries\",\"Temper21=\"#2.12,\"Temper22=\"#3.12\n\t\tD23,#801,,\"telemetry\",\"#1027=\"#1027,\"#1028=\"#1028,\"#1029=\"#1029,\"#1030=\"#1030,\"#1031=\"#1031,\"#1032=\"#1032,\"O103=\"#2.11,\"O104=\"#3.11,\"Energy21_Wh=\"#2.6,\"Energy22_Wh=\"#3.6,\"#1006=\"#1006,\"#1012=\"#1012\n\t)\n",
