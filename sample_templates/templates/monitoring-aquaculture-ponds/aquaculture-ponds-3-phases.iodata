    {
      "io_group_id": 4,
      "io_group": "API",
      "io_n_list": [
        {
          "n_id": "3",
          "n_name": "điều khiển từ xa",
          "n_content": "// N3: Dieu khien bang tay ao 1-2, quat 1-2; giu co tra ket qua\n\t[#4=\"\"](\n\t\tD9\"không có quyền điều khiển\"\n\t)\n\t[(#1<>1&#1<>2)|(#2<>1&#2<>2)](\n\t\tD9\"Ao va quat phai 1-2\"\n\t)\n\tD4#5,(#1-1)*2+100+#2\n\t[#3=\"ON\"](\n\t\tD1O#5\n\t\tD5N101,#1,\"on\",\"bật bơm \"#2\" bằng tay\",#4\n\t)\n\t[#3=\"OFF\"](\n\t\tD2O#5\n\t\tD5N101,#1,\"off\",\"tắt O1 bằng tay\",#4\n\t)\n\tD21,#801,\"telemetry\",\"O\"#5\"=\"O#5\n\tD9\"Điều khiển thành công O\"#5\n",
          "n_mode": "1",
          "n_returncm": true,
          "n_disabledcm": false,
          "n_natural": "",
          "n_desc": "",
          "n_local_def": [
            {
              "l_id": 87225,
              "l_type": "variable",
              "l_cm": "#4",
              "l_natural": "email"
            },
            {
              "l_id": 91645,
              "l_type": "variable",
              "l_cm": "#3",
